{
  "rules": {
    "villages": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "dons": {
      ".read": "auth != null",
      ".indexOn": [
        "to"
      ],
      "$id": {
        ".write": "auth != null && (data.exists() ? (data.child('to').val() === auth.uid || data.child('from').val() === auth.uid) : newData.child('from').val() === auth.uid)"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "duo": {
      "inbox": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$msg": {
            ".write": "auth != null"
          }
        }
      },
      "live": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "imported": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid"
      }
    }
  }
}